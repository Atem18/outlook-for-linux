{
    "app-id": "io.github.kevinmesser.outlook-for-linux",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "base": "org.electronjs.Electron2.BaseApp",
    "base-version": "25.08",
    "command": "outlook-for-linux",
    "separate-locales": false,
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=network",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.StatusNotifierWatcher"
    ],
    "modules": [
        {
            "name": "outlook-for-linux",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "dir",
                    "path": "../dist/linux-unpacked",
                    "dest": "main"
                },
                {
                    "type": "file",
                    "path": "outlook-for-linux.sh"
                },
                {
                    "type": "file",
                    "path": "io.github.kevinmesser.outlook-for-linux.desktop"
                },
                {
                    "type": "file",
                    "path": "../assets/icon.png"
                }
            ],
            "build-commands": [
                "cp -r main /app/",
                "install -Dm755 outlook-for-linux.sh /app/bin/outlook-for-linux",
                "install -Dm644 io.github.kevinmesser.outlook-for-linux.desktop /app/share/applications/io.github.kevinmesser.outlook-for-linux.desktop",
                "install -Dm644 icon.png /app/share/icons/hicolor/256x256/apps/io.github.kevinmesser.outlook-for-linux.png"
            ]
        }
    ]
}
